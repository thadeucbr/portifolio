# Tagueie a imagem pelo SHA curto de main antes de cada publicação.
PORTFOLIO_IMAGE_TAG=replace-with-main-commit-sha
PORTFOLIO_BIND_IP=192.168.1.239
PORTFOLIO_PORT=3000

# Opcional; manter vazio faz o contato falhar fechado em produção.
# Configure diretamente no .env do servidor (chmod 600), nunca no Git/chat.
CONTACT_WEBHOOK_URL=
