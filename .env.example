# Tagueie a imagem pelo SHA curto de main antes de cada publicação.
PORTFOLIO_IMAGE_TAG=replace-with-main-commit-sha
PORTFOLIO_BIND_IP=192.168.1.239
PORTFOLIO_PORT=3000

# Caminho do arquivo secreto local ao barbudas; o token nunca vai ao Git.
TELEGRAM_BOT_TOKEN_SOURCE=./secrets/telegram_bot_token
# Chat ID pessoal ou de grupo; não é o token do bot.
TELEGRAM_CHAT_ID=
